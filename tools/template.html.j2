<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Демо сайту: {{ s.name }}, {{ s.short_address }}</title>
<meta name="description" content="{{ s.meta_description }} Демо-концепт сайту.">
<!-- Демо не індексується. Прибрати під час запуску. -->
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="{{ t.primary_dark }}">
<meta property="og:type" content="website">
<meta property="og:locale" content="uk_UA">
<meta property="og:title" content="Демо сайту: {{ s.name }}, {{ s.short_address }}">
<meta property="og:description" content="{{ s.og_description }}">
<meta property="og:image" content="{{ base_url }}{{ s.slug }}/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="{{ base_url }}{{ s.slug }}/">
<link rel="icon" href="data:image/svg+xml,{{ s.logo_svg | urlencode }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="{{ t.fonts_url }}" rel="stylesheet">
<script type="application/ld+json">{{ schema | safe }}</script>
<style>
  :root{
    --bg:{{ t.bg }};--surface:#FFFFFF;--ink:{{ t.ink }};--muted:{{ t.muted }};--line:{{ t.line }};
    --primary:{{ t.primary }};--primary-dark:{{ t.primary_dark }};--on-primary:{{ t.on_primary }};
    --deep:{{ t.deep }};--on-deep:{{ t.on_deep }};--on-deep-muted:{{ t.on_deep_muted }};
    --soft:{{ t.soft }};--accent:{{ t.accent }};--icon:{{ t.icon }};--danger:#A3361F;
    --display:{{ t.display_font | safe }};--body:"Golos Text",system-ui,-apple-system,"Segoe UI",sans-serif;
    --h-weight:{{ t.h_weight }};--radius:{{ t.radius }};
  }
  *{box-sizing:border-box}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{margin:0;background:var(--surface);color:var(--ink);font:400 17px/1.55 var(--body);padding-bottom:76px}
  a{color:inherit}
  svg{display:block}
  :focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}
  .wrap{max-width:1120px;margin:0 auto;padding:0 20px}
  h1,h2,h3{font-family:var(--display);font-weight:var(--h-weight);margin:0;letter-spacing:{{ t.h_tracking }}}
  h1{font-size:{{ t.h1_size }};line-height:1.08}
  h2{font-size:{{ t.h2_size }};line-height:1.15}
  h3{font-family:{{ t.h3_font | safe }};font-size:17px;line-height:1.3;font-weight:600;letter-spacing:0}
  p{margin:0}

  .demo-note{background:var(--deep);color:var(--on-deep-muted);font-size:13.5px;line-height:1.45;padding:9px 0}
  .demo-note b{color:var(--on-deep);font-weight:600}

  .top{background:var(--surface);border-bottom:2px solid var(--line)}
  .top__in{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:68px}
  .brand{text-decoration:none;display:flex;align-items:center;gap:12px;min-width:0}
  .brand__mark{width:34px;height:34px;flex:none}
  .brand__text{display:flex;flex-direction:column;line-height:1.1;min-width:0}
  .brand__name{font-family:var(--display);font-weight:var(--h-weight);font-size:{{ t.brand_size }};color:var(--primary-dark)}
  .brand__sub{font-size:13px;color:var(--muted);margin-top:3px}
  .top__phone{font-weight:600;text-decoration:none;font-size:17px;white-space:nowrap;display:none}
  .top__phone:hover{color:var(--primary-dark)}

  .slab{background:var(--surface);border:2px solid var(--line);border-radius:var(--radius);padding:26px 22px}

  .hero{padding:48px 0}
  .hero__in{display:grid;gap:24px;align-items:center}
  .hero__panel{max-width:620px}
  .status{display:inline-flex;align-items:center;gap:8px;font-size:14.5px;font-weight:500;color:var(--muted);margin-bottom:16px}
  .status::before{content:"";width:9px;height:9px;border-radius:50%;background:#B9C4C2}
  .status.is-open{color:#1F6B49}
  .status.is-open::before{background:#2E9A6B;box-shadow:0 0 0 4px #D7EFE4}
  .lead{margin-top:16px;font-size:18px;color:var(--muted);max-width:52ch}
  .actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:0 22px;border-radius:var(--radius);font:600 16.5px/1 var(--body);text-decoration:none;border:2px solid transparent;cursor:pointer;white-space:nowrap}
  @media (max-width:479px){ .actions .btn{flex:1 1 100%;padding:0 16px;font-size:16px} }
  @media (max-width:359px){ .btn__num{display:none} }
  .btn svg{width:20px;height:20px;flex:none}
  .btn--primary{background:var(--primary);color:var(--on-primary)}
  .btn--primary:hover{background:var(--primary-dark);color:{{ t.on_primary_hover }}}
  .btn--ghost{border-color:var(--primary-dark);color:var(--primary-dark);background:var(--surface)}
  .btn--ghost:hover{background:var(--soft)}
  .btn--light{background:#fff;color:var(--deep)}
  .btn--light:hover{background:var(--soft)}
  .btn--outline-light{border-color:rgba(255,255,255,.7);color:#fff;background:transparent}
  .btn--outline-light:hover{background:rgba(255,255,255,.1)}
  .rating{display:inline-flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:22px;font-size:15px;color:var(--muted);text-decoration:none}
  .rating:hover span:last-child{text-decoration:underline}
  .stars{color:{{ t.star }};letter-spacing:2px;font-size:16px}
  .rating strong{color:var(--ink);font-weight:600}
  .hero__art{display:none}

  .section{padding:64px 0}
  .section-lead{margin-top:10px;color:var(--muted);max-width:56ch}

  .wall{list-style:none;margin:28px 0 0;padding:{{ t.wall_pad }};display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:{{ t.wall_gap }};background:{{ t.wall_bg }};border-radius:calc(var(--radius) + 2px)}
  .tile{min-width:0;aspect-ratio:1/1;display:flex;flex-direction:column;justify-content:space-between;gap:12px;padding:16px;border-radius:var(--radius);background:{{ t.tile_bg | safe }};position:relative}
  .tile svg{width:46px;height:46px;color:var(--icon)}
  .tile__name{font-family:var(--body);font-weight:600;font-size:15.5px;line-height:1.3;overflow-wrap:break-word;hyphens:auto}
  .tile__note{font-size:13.5px;color:var(--muted);line-height:1.35;margin-top:4px;font-weight:400;display:block}
  .wall > li.wall__cta{display:flex;grid-column:span {{ cta_span_mobile }}}
  .tile--cta{flex:1;aspect-ratio:auto;min-height:150px;background:var(--deep);color:var(--on-deep);text-decoration:none}
  .tile--cta .tile__name{font-family:var(--display);font-weight:var(--h-weight);font-size:18px;max-width:24ch;line-height:1.25;hyphens:manual}
  @media (min-width:640px){ .tile--cta .tile__name{font-size:{{ t.cta_size }}} }
  .tile--cta .tile__go{font-size:15px;font-weight:500;color:var(--on-deep-muted);display:flex;align-items:center;gap:8px}
  .tile--cta:hover{filter:brightness(1.08)}
  .tile--cta svg{width:22px;height:22px;color:var(--on-deep)}

  .band{padding:56px 0;background:{{ t.band_bg | safe }};color:var(--on-deep)}
  .band__in{max-width:760px;background:var(--deep);border:2px solid rgba(255,255,255,.16);border-radius:var(--radius);padding:26px 22px}
  .band p{margin-top:14px;font-size:18px;color:var(--on-deep-muted);max-width:56ch}
  .band .actions{margin-top:26px}

  .why{background:var(--soft)}
  .why__grid{display:grid;gap:28px}
  .why__list{list-style:none;margin:0;padding:0;display:grid;gap:22px}
  .why__list li{padding-left:22px;position:relative}
  .why__list li::before{content:"";position:absolute;left:0;top:6px;width:10px;height:10px;background:{{ t.bullet }};border-radius:2px}
  .why__list p{color:var(--muted);margin-top:6px;max-width:48ch}

  .steps{list-style:none;counter-reset:s;margin:28px 0 0;padding:0;display:grid;gap:14px}
  .steps li{counter-increment:s;display:grid;grid-template-columns:44px 1fr;gap:16px;align-items:start;padding:18px;border:2px solid var(--line);border-radius:var(--radius)}
  .steps li::before{content:counter(s);display:grid;place-items:center;width:44px;height:44px;border-radius:var(--radius);background:var(--deep);color:var(--on-deep);font:700 18px/1 var(--body)}
  .steps p{color:var(--muted);margin-top:4px}

  .callback{border-top:2px solid var(--line)}
  .callback__grid{display:grid;gap:28px}
  .form{display:grid;gap:16px}
  .field{display:grid;gap:6px}
  .field label{font-weight:600;font-size:15.5px}
  .field .hint{font-weight:400;color:var(--muted)}
  .field input,.field textarea{font:inherit;color:var(--ink);background:var(--surface);border:2px solid var(--line);border-radius:var(--radius);padding:12px 14px;min-height:52px;width:100%}
  .field textarea{min-height:96px;resize:vertical}
  .field input:focus,.field textarea:focus{outline:none;border-color:var(--primary-dark);box-shadow:0 0 0 3px var(--soft)}
  .field input[aria-invalid="true"]{border-color:var(--danger)}
  .field__error{color:var(--danger);font-size:14.5px;font-weight:500}
  .form .btn{justify-self:start}
  .form__result{padding:14px 16px;border-radius:var(--radius);background:var(--soft);color:var(--ink);font-size:15.5px}
  .form__result b{font-weight:600}
  .form__aside{font-size:15px;color:var(--muted)}
  .form__aside a{color:var(--primary-dark);font-weight:600}

  .faq{margin-top:24px;border-top:2px solid var(--line)}
  .faq details{border-bottom:2px solid var(--line)}
  .faq summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 2px;font-weight:600;font-size:16.5px;line-height:1.35}
  .faq summary::-webkit-details-marker{display:none}
  .faq summary::after{content:"";flex:none;width:14px;height:14px;background:linear-gradient(var(--primary-dark),var(--primary-dark)) center/14px 2px no-repeat,linear-gradient(var(--primary-dark),var(--primary-dark)) center/2px 14px no-repeat;transition:transform .2s ease}
  .faq details[open] summary::after{transform:rotate(45deg)}
  .faq details p{padding:0 2px 20px;color:var(--muted);max-width:62ch}

  .visit{background:{{ t.visit_bg | safe }}}
  .visit__grid{display:grid;gap:28px;margin-top:28px}
  .addr{font-size:19px;font-weight:600;line-height:1.35}
  .addr a{text-decoration:none}
  .addr a:hover{text-decoration:underline}
  .addr__note{display:block;font-size:15px;font-weight:400;color:var(--muted);margin-top:4px}
  .hours{width:100%;max-width:380px;border-collapse:collapse;margin-top:20px;font-size:16px}
  .hours td{padding:8px 10px;border-bottom:1px solid var(--line)}
  .hours td:last-child{text-align:right;font-variant-numeric:tabular-nums}
  .hours tr.is-today td{background:var(--soft);font-weight:600;color:var(--primary-dark)}
  .map{border:2px solid var(--line);border-radius:var(--radius);overflow:hidden;min-height:320px;background:var(--bg)}
  .map iframe{display:block;width:100%;height:100%;min-height:320px;border:0}

  .foot{background:var(--deep);color:var(--on-deep-muted);padding:40px 0;font-size:15px}
  .foot__in{display:grid;gap:18px}
  .foot .brand__name{color:var(--on-deep)}
  .foot__addr{margin-top:8px}
  .foot__phone{font-weight:600;font-size:18px;color:var(--on-deep);text-decoration:none}
  .foot__phone:hover{text-decoration:underline}
  .foot__demo{border-top:1px solid rgba(255,255,255,.18);padding-top:18px;font-size:13.5px;max-width:70ch;opacity:.85}

  .callbar{position:fixed;left:0;right:0;bottom:0;z-index:20;display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:10px 12px calc(10px + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);border-top:2px solid var(--line);backdrop-filter:blur(6px)}
  .callbar .btn{min-height:48px;padding:0 12px}

  @media (min-width:640px){
    .wall{grid-template-columns:repeat(3,minmax(0,1fr))}
    .wall > li.wall__cta{grid-column:span {{ cta_span_desktop }}}
    .tile{padding:20px;aspect-ratio:5/4}
    .tile--cta{aspect-ratio:auto;min-height:0}
    .tile svg{width:56px;height:56px}
    .tile__name{font-size:16.5px}
    .slab{padding:34px}
    .band__in{padding:34px}
    .steps{grid-template-columns:repeat(3,1fr)}
    .steps li{grid-template-columns:1fr;gap:14px}
  }
  @media (min-width:860px){
    body{padding-bottom:0}
    .callbar{display:none}
    .top__phone{display:block}
    .hero{padding:64px 0}
    .hero__in{grid-template-columns:minmax(0,620px) 1fr}
    .hero__art{display:block;justify-self:center}
    .why__grid{grid-template-columns:5fr 7fr;align-items:start}
    .why__list{grid-template-columns:1fr 1fr;gap:28px 32px}
    .callback__grid{grid-template-columns:5fr 7fr;align-items:start}
    .faq__grid{display:grid;grid-template-columns:5fr 7fr;gap:28px;align-items:start}
    .faq__grid .faq{margin-top:0}
    .visit__grid{grid-template-columns:5fr 7fr;align-items:stretch}
    .section{padding:88px 0}
    .foot__in{grid-template-columns:1fr auto;align-items:start}
    .foot__demo{grid-column:1/-1}
  }
  @media (min-width:1000px){
    .range__grid{display:grid;grid-template-columns:4fr 7fr;gap:48px;align-items:start}
    .range__grid .wall{margin-top:0}
    .tile{aspect-ratio:1/1}
    .tile--cta{aspect-ratio:auto}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto}
    .faq summary::after{transition:none}
  }

  /* ---- тема: {{ t.key }} ---- */
{{ t.extra_css | safe }}
</style>
</head>
<body>

<div class="demo-note" role="note">
  <div class="wrap"><b>Демо-концепт.</b> Це не офіційний сайт «{{ s.name }}». Його підготовлено для показу власнику, послуги й тексти наведено як приклад.</div>
</div>

<header class="top">
  <div class="wrap top__in">
    <a class="brand" href="#top" aria-label="{{ s.name }}, на початок сторінки">
      <span class="brand__mark" aria-hidden="true">{{ s.logo_svg | safe }}</span>
      <span class="brand__text">
        <span class="brand__name">{{ s.name }}</span>
        <span class="brand__sub">{{ s.brand_sub }}</span>
      </span>
    </a>
    <a class="top__phone" href="tel:{{ s.phone_e164 }}" data-track="call_click">{{ s.phone }}</a>
  </div>
</header>

<main id="top">
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap hero__in">
      <div class="slab hero__panel">
        <p class="status" id="status" hidden></p>
        <h1 id="hero-title">{{ s.h1 }}</h1>
        <p class="lead">{{ s.lead }}</p>
        <div class="actions">
          <a class="btn btn--primary" href="tel:{{ s.phone_e164 }}" data-track="call_click">{{ icons.phone | safe }}<span>Подзвонити<span class="btn__num">: {{ s.phone }}</span></span></a>
          <a class="btn btn--ghost" href="viber://chat?number=%2B{{ s.phone_e164[1:] }}" data-track="viber_click">{{ icons.chat | safe }}Написати у Viber</a>
        </div>
        <a class="rating" href="{{ maps_place_url }}" target="_blank" rel="noopener" data-track="reviews_click">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span><strong>{{ s.rating_text }}</strong> у Google, {{ s.reviews_text }}</span>
        </a>
      </div>
      <div class="hero__art" aria-hidden="true">{{ s.hero_svg | safe }}</div>
    </div>
  </section>
  {{ t.after_hero_html | safe }}

  <section class="section" id="range" aria-labelledby="range-title">
    <div class="wrap range__grid">
      <div>
        <h2 id="range-title">{{ s.services_title }}</h2>
        <p class="section-lead">{{ s.services_lead }}</p>
      </div>
      <ul class="wall">
        {% for tile in s.tiles %}
        <li class="tile">
          {{ tile.icon | safe }}
          <span class="tile__name">{{ tile.name }}{% if tile.note %}<span class="tile__note">{{ tile.note }}</span>{% endif %}</span>
        </li>
        {% endfor %}
        <li class="wall__cta">
          <a class="tile tile--cta" href="viber://chat?number=%2B{{ s.phone_e164[1:] }}" data-track="viber_click">
            <span class="tile__name">{{ s.cta_tile }}</span>
            <span class="tile__go">{{ icons.chat | safe }}{{ s.cta_tile_go }}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="band-title">
    <div class="wrap">
      <div class="band__in">
        <h2 id="band-title">{{ s.band.title }}</h2>
        <p>{{ s.band.text }}</p>
        {% if s.band.extra_html %}{{ s.band.extra_html | safe }}{% endif %}
        <div class="actions">
          {% if s.band.viber %}<a class="btn btn--light" href="viber://chat?number=%2B{{ s.phone_e164[1:] }}" data-track="viber_click">{{ icons.chat | safe }}{{ s.band.viber }}</a>{% endif %}
          <a class="btn {% if s.band.viber %}btn--outline-light{% else %}btn--light{% endif %}" href="tel:{{ s.phone_e164 }}" data-track="call_click">{% if not s.band.viber %}{{ icons.phone | safe }}{% endif %}{{ s.band.call }}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section why" aria-labelledby="why-title">
    <div class="wrap why__grid">
      <div><h2 id="why-title">{{ s.why_title }}</h2></div>
      <ul class="why__list">
        {% for w in s.why %}
        <li><h3>{{ w[0] }}</h3><p>{{ w[1] }}</p></li>
        {% endfor %}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title">{{ s.steps_title }}</h2>
      <ol class="steps">
        {% for st in s.steps %}
        <li><div><h3>{{ st[0] }}</h3><p>{{ st[1] }}</p></div></li>
        {% endfor %}
      </ol>
    </div>
  </section>

  <section class="section callback" id="callback" aria-labelledby="callback-title">
    <div class="wrap callback__grid">
      <div>
        <h2 id="callback-title">{{ s.form.title }}</h2>
        <p class="section-lead">{{ s.form.lead }}</p>
      </div>
      <form class="form" id="callback-form" novalidate>
        <div class="field">
          <label for="f-name">Імʼя <span class="hint">(необовʼязково)</span></label>
          <input id="f-name" name="name" type="text" autocomplete="given-name">
        </div>
        <div class="field">
          <label for="f-phone">Телефон</label>
          <input id="f-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="067 123 45 67" aria-describedby="f-phone-error" required>
          <p class="field__error" id="f-phone-error" hidden>Вкажіть номер телефону, наприклад 067 123 45 67.</p>
        </div>
        <div class="field">
          <label for="f-need">{{ s.form.need_label }} <span class="hint">(необовʼязково)</span></label>
          <textarea id="f-need" name="need" placeholder="{{ s.form.need_placeholder }}"></textarea>
        </div>
        <button class="btn btn--primary" type="submit">{{ s.form.button }}</button>
        {% if s.form.aside %}<p class="form__aside">{{ s.form.aside | safe }}</p>{% endif %}
        <p class="form__result" id="form-result" role="status" hidden></p>
      </form>
    </div>
  </section>

  <section class="section why" aria-labelledby="faq-title">
    <div class="wrap faq__grid">
      <h2 id="faq-title">Часті питання</h2>
      <div class="faq">
        {% for q in s.faq %}
        <details><summary>{{ q[0] }}</summary><p>{{ q[1] }}</p></details>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="section visit" aria-labelledby="visit-title">
    <div class="wrap">
      <div class="slab">
        <h2 id="visit-title">Як нас знайти</h2>
        <div class="visit__grid">
          <div>
            <p class="addr"><a href="{{ maps_dir_url }}" target="_blank" rel="noopener" data-track="route_click">{{ s.address_display }}</a>{% if s.address_note %}<span class="addr__note">{{ s.address_note }}</span>{% endif %}</p>
            <table class="hours" aria-label="Графік роботи">
              <tbody>
                {% for row in hours_rows %}
                <tr{% if row.day is not none %} data-day="{{ row.day }}"{% endif %}><td>{{ row.label }}</td><td>{{ row.value }}</td></tr>
                {% endfor %}
              </tbody>
            </table>
            <div class="actions">
              <a class="btn btn--primary" href="{{ maps_dir_url }}" target="_blank" rel="noopener" data-track="route_click">Прокласти маршрут</a>
              <a class="btn btn--ghost" href="tel:{{ s.phone_e164 }}" data-track="call_click">{{ s.phone }}</a>
            </div>
          </div>
          <div class="map">
            <iframe title="{{ s.name }} на карті" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="{{ maps_embed_url }}"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer class="foot">
  <div class="wrap foot__in">
    <div>
      <span class="brand__name">{{ s.name }}</span>
      <p class="foot__addr">{{ s.address_display }}</p>
    </div>
    <a class="foot__phone" href="tel:{{ s.phone_e164 }}" data-track="call_click">{{ s.phone }}</a>
    <p class="foot__demo">Демо-концепт сайту. Його підготував Богдан Баланик, щоб обговорити з власником. Адресу, телефон, графік і рейтинг взято з Google Maps, а послуги й тексти наведено як приклад, їх уточнимо перед запуском.</p>
  </div>
</footer>

<nav class="callbar" aria-label="Швидкий звʼязок">
  <a class="btn btn--primary" href="tel:{{ s.phone_e164 }}" data-track="call_click">{{ icons.phone | safe }}Подзвонити</a>
  <a class="btn btn--ghost" href="viber://chat?number=%2B{{ s.phone_e164[1:] }}" data-track="viber_click">{{ icons.chat | safe }}Viber</a>
</nav>

<script>
(function(){
  var hours = {{ hours_json | safe }}; /* день тижня (0 = неділя) -> [відкриття, закриття] або null */
  var always = {{ 'true' if always_open else 'false' }};
  var el = document.getElementById('status');
  if (always){ el.textContent = 'Відчинено цілодобово'; el.classList.add('is-open'); el.hidden = false; return; }
  var days = {Sun:0,Mon:1,Tue:2,Wed:3,Thu:4,Fri:5,Sat:6};
  function fmt(h){ var m = Math.round((h % 1) * 60); return Math.floor(h) + ':' + (m < 10 ? '0' : '') + m; }
  var names = ['у неділю','у понеділок','у вівторок','у середу','у четвер','у пʼятницю','у суботу'];
  function kyivNow(){
    var zones = ['Europe/Kyiv','Europe/Kiev'];
    for (var i = 0; i < zones.length; i++){
      try{
        var parts = new Intl.DateTimeFormat('en-GB',{timeZone:zones[i],weekday:'short',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
        var o = {}; parts.forEach(function(p){ o[p.type] = p.value; });
        return {day:days[o.weekday], time:(parseInt(o.hour,10) % 24) + parseInt(o.minute,10)/60};
      }catch(e){}
    }
    return null;
  }
  var now = kyivNow();
  if (!now || now.day === undefined) return;
  var row = document.querySelector('.hours tr[data-day="' + now.day + '"]');
  if (row) row.classList.add('is-today');
  var t = hours[now.day], text, open = false;
  if (t && now.time >= t[0] && now.time < t[1]) { open = true; text = 'Зараз відчинено, до ' + fmt(t[1]); }
  else if (t && now.time < t[0]) { text = 'Зараз зачинено, відчинимося о ' + fmt(t[0]); }
  else {
    for (var k = 1; k <= 7; k++){
      var d = (now.day + k) % 7;
      if (hours[d]) { text = 'Зараз зачинено, відчинимося ' + (k === 1 ? 'завтра' : names[d]) + ' о ' + fmt(hours[d][0]); break; }
    }
  }
  el.textContent = text;
  if (open) el.classList.add('is-open');
  el.hidden = false;
})();

(function(){
  var form = document.getElementById('callback-form');
  if (!form) return;
  var phone = document.getElementById('f-phone');
  var error = document.getElementById('f-phone-error');
  var result = document.getElementById('form-result');
  function validPhone(v){ return v.replace(/\D/g,'').length >= 10; }
  phone.addEventListener('input', function(){
    if (phone.getAttribute('aria-invalid') === 'true' && validPhone(phone.value)){ phone.removeAttribute('aria-invalid'); error.hidden = true; }
  });
  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (!validPhone(phone.value)){ phone.setAttribute('aria-invalid','true'); error.hidden = false; result.hidden = true; phone.focus(); return; }
    result.innerHTML = '<b>Це демо, тому заявку не надіслано.</b> На робочому сайті вона одразу прийде власнику в Telegram.';
    result.hidden = false;
    if (typeof window.gtag === 'function') window.gtag('event', 'form_submit');
  });
})();

document.addEventListener('click', function(e){
  var el = e.target.closest ? e.target.closest('[data-track]') : null;
  if (!el) return;
  if (typeof window.gtag === 'function') window.gtag('event', el.getAttribute('data-track'));
});
</script>
</body>
</html>
